{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    // Biome sjekker bare filene som er listet her. Fra 2.6 formaterer Biome også YAML og Markdown,
    // og en full check:fix skrev «image: {{ image }}» i .nais om til «{ { image } }», så deploy feilet.
    "files": {
        "includes": ["src/**", ".vscode/**", "package.json", "tsconfig.base.json", "tsconfig.json", "biome.jsonc"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noArrayIndexKey": "warn"
            }
        }
    },
    "javascript": {
        "formatter": {
            "trailingCommas": "es5",
            "arrowParentheses": "asNeeded",
            "quoteStyle": "single"
        }
    },
    "html": {
        "parser": {
            "interpolation": true
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/tsconfig*.json"],
            "json": {
                "parser": {
                    "allowComments": true,
                    "allowTrailingCommas": true
                }
            }
        }
    ]
}
